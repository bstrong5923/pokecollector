# Template for the DEV Firebase project settings.
# 1. Copy this file and name the copy:  .env.development.local
# 2. Replace each value with the ones from your dev project (Firebase console > Project settings > Your apps).
# 3. Restart "npm run dev".
# .env.development.local is ignored by git, and only "npm run dev" reads it.
# (This example file has no real values, so it is fine to commit.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# measurement id is optional (only if Google Analytics is on)
VITE_FIREBASE_MEASUREMENT_ID=
